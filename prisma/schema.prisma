generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  password    String
  role        String // "super_admin" | "assistant"
  permissions Json?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model Course {
  id                     Int       @id @default(autoincrement())
  title                  String
  slug                   String    @unique
  fee                    Float?
  discount_fee           Float?
  start_date             DateTime?
  end_date               DateTime?
  thumbnail              String?   @db.Text
  details                String?   @db.Text
  subjects               Json?
  next_registration_date DateTime?
  status                 String    @default("active")
  sort_order             Int       @default(0)
  created_at             DateTime  @default(now())

  batches       Batch[]
  video_courses VideoCourse[]
  exams         Exam[]
  notes         NoteMaterial[]
  form_submissions FormSubmission[]
}

model Batch {
  id           Int      @id @default(autoincrement())
  course_id    Int
  name         String
  start_time   String   @default("10:00 AM")
  end_time     String   @default("12:00 PM")
  status       String   @default("active")
  max_students Int?
  class_days   Json?
  sort_order   Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  course       Course         @relation(fields: [course_id], references: [id], onDelete: Cascade)
  students     Student[]
  routines     Routine[]
  exams        Exam[]
  notes        NoteMaterial[]
  videoCourses VideoCourse[]
}

model Student {
  id              Int       @id @default(autoincrement())
  student_id      String    @unique // Auto format #0001
  name            String
  gender          String
  dob             DateTime?
  address         String?   @db.Text
  phone           String
  email           String?
  password        String
  batch_id        Int?
  parent_name     String?
  parent_relation String?
  parent_phone    String?
  photo           String?   @db.Text
  status          String    @default("active") // "active" | "inactive"
  enrolled_at     DateTime  @default(now())
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  batch        Batch?          @relation(fields: [batch_id], references: [id], onDelete: SetNull)
  payments     Payment[]
  exam_results ExamResult[]
  attendance   Attendance[]
  reviews      StudentReview[]
  reports      StudentReport[]
}

model Routine {
  id           Int      @id @default(autoincrement())
  batch_id     Int
  day_of_week  String
  start_time   String
  end_time     String
  subject      String
  room         String?
  teacher_name String?
  created_at   DateTime @default(now())

  batch Batch @relation(fields: [batch_id], references: [id], onDelete: Cascade)
}

model Exam {
  id               Int       @id @default(autoincrement())
  title            String
  batch_id         Int? // Nullable for course-wide or public exams
  course_id        Int?
  type             String // "online_mcq" | "offline"
  is_public        Boolean   @default(false)
  start_time       DateTime?
  end_time         DateTime?
  duration_minutes Int
  total_marks      Float
  status           String    @default("active") // "active" | "inactive" | "completed"
  negative_marking Float     @default(0.0)
  is_grading_enabled Boolean @default(false)
  created_at       DateTime  @default(now())

  batch               Batch?                  @relation(fields: [batch_id], references: [id], onDelete: SetNull)
  course              Course?                 @relation(fields: [course_id], references: [id], onDelete: Cascade)
  questions           ExamQuestion[]
  results             ExamResult[]
  public_participants PublicExamParticipant[]
}

model ExamQuestion {
  id             Int     @id @default(autoincrement())
  exam_id        Int
  parent_id      Int?
  type           String  @default("mcq") // "mcq" | "passage"
  question_text  String  @db.Text
  image_url      String?  @db.Text
  image_urls     Json?
  options        Json? // Dynamic options array
  correct_option String?
  marks          Float   @default(1.0)
  explanation    String? @db.Text
  sort_order     Int     @default(0)

  exam     Exam           @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  parent   ExamQuestion?  @relation("PassageQuestions", fields: [parent_id], references: [id], onDelete: Cascade)
  children ExamQuestion[] @relation("PassageQuestions")
}

model ExamResult {
  id                 Int      @id @default(autoincrement())
  exam_id            Int
  student_id         Int? // Nullable for public participants
  obtained_marks     Float
  total_marks        Float
  correct_count      Int      @default(0)
  wrong_count        Int      @default(0)
  skipped_count      Int      @default(0)
  rank               Int?
  answers            Json?
  time_taken_seconds Int?
  comment            String?  @db.Text
  grade              String?
  created_at         DateTime @default(now())

  exam               Exam                   @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  student            Student?               @relation(fields: [student_id], references: [id], onDelete: SetNull)
  public_participant PublicExamParticipant?
}


model PublicExamParticipant {
  id             Int      @id @default(autoincrement())
  exam_id        Int
  name           String
  phone          String
  institution    String?
  study_level    String?
  location       String?
  exam_result_id Int      @unique
  created_at     DateTime @default(now())

  exam   Exam       @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  result ExamResult @relation(fields: [exam_result_id], references: [id], onDelete: Cascade)
}

model Payment {
  id             Int       @id @default(autoincrement())
  student_id     Int
  amount         Float
  discount       Float     @default(0.0)
  due_amount     Float     @default(0.0)
  month          Int
  year           Int
  status         String // "paid" | "due" | "partial"
  receipt_number String?   @unique
  payment_type   String?
  invoice        String?   @unique
  paid_at        DateTime?
  note           String?   @db.Text
  created_at     DateTime  @default(now())

  student Student @relation(fields: [student_id], references: [id])
}

model Expense {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?  @db.Text
  amount       Float
  expended_by  String?
  permitted_by String?
  expense_date DateTime @default(now())
  note         String?  @db.Text
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

model PaymentType {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  created_at DateTime @default(now())
}

model Attendance {
  id         Int      @id @default(autoincrement())
  student_id Int
  batch_id   Int
  date       DateTime @db.Date
  status     String // "present" | "absent" | "late"
  note       String?
  created_at DateTime @default(now())

  student Student @relation(fields: [student_id], references: [id])
}

model Notice {
  id          Int      @id @default(autoincrement())
  title       String
  content     String   @db.Text
  target_type String // "all" | "course" | "batch"
  target_id   Int?
  type        String // "general" | "exam" | "result"
  is_pinned   Boolean  @default(false)
  created_at  DateTime @default(now())
}

model Gallery {
  id         Int      @id @default(autoincrement())
  image_path String   @db.Text
  category   String // "home" | "success" | "about"
  caption    String?
  sort_order Int      @default(0)
  created_at DateTime @default(now())
}

model Teacher {
  id                  Int      @id @default(autoincrement())
  name                String
  bio                 String?  @db.Text
  qualifications      String?
  specialist_subjects Json?
  experience          String?
  photo               String?  @db.Text
  sort_order          Int      @default(0)
  created_at          DateTime @default(now())

  success_stories TeacherSuccess[]
}

model TeacherSuccess {
  id           Int      @id @default(autoincrement())
  teacher_id   Int
  student_name String
  exam_type    String
  gpa          String?
  placement    String?
  photo        String?  @db.Text
  year         String?
  sort_order   Int      @default(0)
  created_at   DateTime @default(now())

  teacher Teacher @relation(fields: [teacher_id], references: [id])
}

model StudentReview {
  id               Int      @id @default(autoincrement())
  student_name     String
  image            String?  @db.Text
  batch_name       String?
  current_position String?
  description      String   @db.Text
  rating           Int      @default(5)
  is_featured      Boolean  @default(false)
  sort_order       Int      @default(0)
  created_at       DateTime @default(now())

  student_id Int?
  student    Student? @relation(fields: [student_id], references: [id])
}

model VideoCourse {
  id          Int      @id @default(autoincrement())
  course_id   Int
  batch_id    Int?
  title       String
  description String?  @db.Text
  url         String   @db.Text // YouTube/external link
  price       Float    @default(0.0)
  is_free     Boolean  @default(false)
  is_public   Boolean  @default(true)
  tags        Json?
  thumbnail   String?  @db.Text
  status      String   @default("active")
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())

  course Course @relation(fields: [course_id], references: [id], onDelete: Cascade)
  batch  Batch? @relation(fields: [batch_id], references: [id], onDelete: SetNull)
}

model DemoVideo {
  id            Int      @id @default(autoincrement())
  section_title String
  video_url     String   @db.Text
  video_title   String   @db.Text
  thumbnail_url String   @db.Text
  is_active     Boolean  @default(true)
  sort_order    Int      @default(0)
  created_at    DateTime @default(now())
}

model NoteMaterial {
  id          Int      @id @default(autoincrement())
  title       String
  file_path   String   @db.Text
  batch_id    Int?
  course_id   Int?
  type        String // "book" | "note"
  description String?  @db.Text
  is_public   Boolean  @default(false)
  status      String   @default("active") // "active" | "inactive"
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())

  batch  Batch?  @relation(fields: [batch_id], references: [id], onDelete: SetNull)
  course Course? @relation(fields: [course_id], references: [id], onDelete: Cascade)
}

model SiteSetting {
  id            Int      @id @default(autoincrement())
  setting_key   String   @unique
  setting_value String   @db.Text
  setting_type  String // "text" | "image" | "json" | "boolean"
  group_name    String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model SocialMedia {
  id            Int      @id @default(autoincrement())
  platform_name String
  url           String
  icon          String?
  sort_order    Int      @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
}

model HeroBanner {
  id            Int      @id @default(autoincrement())
  teacher_photo String?  @db.Text
  description   String?  @db.Text
  bg_image      String?  @db.Text
  cta_text      String?
  cta_link      String?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
}

model SmsLog {
  id         Int       @id @default(autoincrement())
  student_id Int?
  phone      String
  message    String    @db.Text
  type       String // "exam_notice" | "result" | "attendance"
  status     String // "sent" | "failed" | "queued"
  sent_at    DateTime?
  created_at DateTime  @default(now())
}

model StudentReport {
  id          Int      @id @default(autoincrement())
  student_id  Int
  title       String
  description String   @db.Text
  type        String   @default("general") // "general" | "disciplinary" | "academic" | "good"
  created_at  DateTime @default(now())

  student Student @relation(fields: [student_id], references: [id])
}


model CronJob {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  schedule    String
  action_type String
  metadata    String?   @db.Text
  is_active   Boolean   @default(true)
  last_run    DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
}

model FormSubmission {
  id         Int      @id @default(autoincrement())
  name       String
  phone      String
  email      String?
  course_id  Int?
  message    String?  @db.Text
  type       String   @default("CONTACT") // "CONTACT" | "MARKETING"
  status     String   @default("PENDING") // "PENDING" | "CONTACTED"
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  
  course     Course?  @relation(fields: [course_id], references: [id], onDelete: SetNull)
}
